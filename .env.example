# Monad Testnet Network Configuration
NEXT_PUBLIC_MONAD_NETWORK=eip155:10143
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_CHAIN_NAME="Monad Testnet"
NEXT_PUBLIC_MONAD_RPC_URL="https://testnet-rpc.monad.xyz"
NEXT_PUBLIC_MONAD_RPC_FALLBACK_1="https://rpc.ankr.com/monad_testnet"
NEXT_PUBLIC_MONAD_RPC_FALLBACK_2="https://rpc-testnet.monadinfra.com"
NEXT_PUBLIC_MONAD_WS_RPC="wss://testnet-rpc.monad.xyz"
NEXT_PUBLIC_MONAD_EXPLORER_URL="https://testnet.monadvision.com"
NEXT_PUBLIC_MONAD_SCAN_URL="https://testnet.monadscan.com"
NEXT_PUBLIC_MONAD_FAUCET_URL="https://faucet.monad.xyz"

# Monad Testnet USDC Token Address
NEXT_PUBLIC_MONAD_USDC_ADDRESS="0x534b2f3A21130d7a60830c2Df862319e593943A3"

# Deployed v2 contracts on Monad Testnet (contracts/deployed-addresses.json). v1 is retired — see README.
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS="0xfdeEE314eb3235a91e00a4EFFb76982F6F96e0C6"
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS="0x3A330F950E830f9e2DE8Dde90742D3459db6C54A"
NEXT_PUBLIC_STAKE_MANAGER_ADDRESS="0x498da2D83e2eC5b3D6FE2499B1dB17719E719da1"
NEXT_PUBLIC_ACADEMY_CREDENTIAL_ADDRESS="0xAbAFE53736e087877561cd0E48C283D6e7e59Ce6"

# x402: each agent is paid at the payee in its IdentityRegistryV2 record (no shared PAY_TO_ADDRESS any more)
# X402_REQUIRE_SETTLEMENT=true      # refuse calls whose USDC transfer can't settle
# MAX_PRICE_UNITS=10000             # most the orchestrator pays per call in Mode A ($0.01)

# Agent routing. Skills resolve to agent ids via IdentityRegistryV2; pin them with AGENT_IDS if needed.
# AGENT_IDS="contract-audit:1,token-risk-score:2,gas-timing:3,whale-tracker:4"
# Optional local overrides of each agent's onchain endpoint (base URL; the router appends /api/...)
# CONTRACT_AUDITOR_URL="http://localhost:4001"
# TOKEN_RISK_URL="http://localhost:4002"
# GAS_TIMING_URL="http://localhost:4003"
# WHALE_AGENT_URL="http://localhost:4004"
ORCHESTRATOR_URL="http://localhost:4000"

# MagicBlock mode (Solana devnet + Ephemeral Rollup). Requests choose with ?chain=magicblock; CHAIN sets the default.
# CHAIN="monad"
SOLANA_RPC_URL="https://rpc.magicblock.app/devnet"
MAGIC_ROUTER_URL="https://devnet-router.magicblock.app"
ER_RPC_URL="https://devnet-us.magicblock.app"
ER_VALIDATOR="MUS3hc9TCw4cGC12vHNoYcCGzJG1txjgQLZWVoeNHNd"
AGENT_MARKET_PROGRAM_ID="AZox8uQ1sjG5KdorG4Y72w3tDT7eowJtxHdQRqMjUXVu"
USDC_MINT="HB4x6Kf2mbiS8LzuZSykJu85qo3CDfFNCiDDps2pmp5f"
# Market authority / Mode A operator: JSON byte array (solana/.keys/operator.json). Never commit.
SOLANA_OPERATOR_SECRET_KEY="[SECRET_KEY_JSON_ARRAY]"
# Optional: lets POST /api/checkpoint (header x-admin-token) force a checkpoint
# CHECKPOINT_ADMIN_TOKEN=""
# Local dev: call MagicBlock agents on this server instead of their onchain endpoints
# MB_AGENT_BASE_URL="http://localhost:8080/mb/agents"

# Deployer / Operator Private Key (Never commit real keys)
DEPLOYER_PRIVATE_KEY="[PRIVATE_KEY]"
ORCHESTRATOR_PRIVATE_KEY="[PRIVATE_KEY]"

# Optional LLM Polish (Off critical path; system works fully without these)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
