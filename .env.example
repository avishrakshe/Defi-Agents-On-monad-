# Monad Testnet Network Configuration
NEXT_PUBLIC_MONAD_NETWORK=eip155:10143
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_CHAIN_NAME="Monad Testnet"
NEXT_PUBLIC_MONAD_RPC_URL="https://testnet-rpc.monad.xyz"
NEXT_PUBLIC_MONAD_RPC_FALLBACK_1="https://rpc.ankr.com/monad_testnet"
NEXT_PUBLIC_MONAD_RPC_FALLBACK_2="https://rpc-testnet.monadinfra.com"
NEXT_PUBLIC_MONAD_WS_RPC="wss://testnet-rpc.monad.xyz"
NEXT_PUBLIC_MONAD_EXPLORER_URL="https://testnet.monadvision.com"
NEXT_PUBLIC_MONAD_SCAN_URL="https://testnet.monadscan.com"
NEXT_PUBLIC_MONAD_FAUCET_URL="https://faucet.monad.xyz"

# Monad Testnet USDC Token Address
NEXT_PUBLIC_MONAD_USDC_ADDRESS="0x534b2f3A21130d7a60830c2Df862319e593943A3"

# Deployed Contract Addresses on Monad Testnet (Populated after Phase 1 deployment)
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS="[IDENTITY_REGISTRY_CONTRACT_ADDRESS]"
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS="[REPUTATION_REGISTRY_CONTRACT_ADDRESS]"
NEXT_PUBLIC_STAKE_MANAGER_ADDRESS="[STAKE_MANAGER_CONTRACT_ADDRESS]"

# x402 Micropayment Protocol Configuration
X402_FACILITATOR_URL="https://x402-facilitator.molandak.org"
NEXT_PUBLIC_X402_FACILITATOR_URL="https://x402-facilitator.molandak.org"
PAY_TO_ADDRESS="[WALLET_ADDRESS]"

# Specialist Agent Endpoints
CONTRACT_AUDITOR_URL="http://localhost:4001"
TOKEN_RISK_URL="http://localhost:4002"
GAS_TIMING_URL="http://localhost:4003"
ORCHESTRATOR_URL="http://localhost:4000"

# Deployer / Operator Private Key (Never commit real keys)
DEPLOYER_PRIVATE_KEY="[PRIVATE_KEY]"
ORCHESTRATOR_PRIVATE_KEY="[PRIVATE_KEY]"

# Optional LLM Polish (Off critical path; system works fully without these)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
