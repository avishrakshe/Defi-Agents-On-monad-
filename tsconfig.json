{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["server.ts", "orchestrator/src/**/*.ts", "agents/**/*.ts"],
  "exclude": ["node_modules", "frontend", "contracts", "**/node_modules"]
}
